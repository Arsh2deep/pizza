<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation</title>
</head>
<body>
    <h1>Thank you for your Order!, <%= order.fname %> <h1>
        <h2>Order Summary</h2>
        <P>Name:<%= order.fname %> <%= order.lname %> </P>
        <p>Email: <%= order.email %> </p>
        <p>Pickup or Delivery: <%= order.method %>  </p>
        <p>Toppings: <%= order.toppings %> </p>
        <p>Size: <%= order.size %> </p>
        <p>Comment: <%= order.comment %> </p>
        <p>Date & Time:  <%= order.timestamp %> </p>
</body>
</html>